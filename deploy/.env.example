# Copy to deploy/.env and fill in. Never commit deploy/.env.

# The public address of the pilot. Its DNS A record must point at this server before the first start.
DOMAIN=pilot.example.com
POSTGRES_PASSWORD=change-me

# "live" is the only mode for real people: sandbox shows login codes on screen and lists every account.
NEXUS_ENV=live
# Two long random strings: openssl rand -hex 48
JWT_SECRET=
LINK_SECRET=

# Pilot: sign-up in Morocco and Guinea only. Both are "record" countries (no money passes through Nexus),
# so no payment partner is needed.
SIGNUP_REGIONS=MA,GN
PAYMENT_PROVIDER=none

# Login codes and notifications by SMS, sent by one Android phone per country running "SMS Gateway for Android"
# (sms-gate.app) with a local SIM. The username and password are shown in the app under "Cloud Server".
SMS_PROVIDER=smsgate
NOTIFIER=sms
SMSGATE_MA_USER=
SMSGATE_MA_PASSWORD=
SMSGATE_GN_USER=
SMSGATE_GN_PASSWORD=
# Optional: one phone for numbers of every other country (for example an admin's own number).
# SMSGATE_USER=
# SMSGATE_PASSWORD=
